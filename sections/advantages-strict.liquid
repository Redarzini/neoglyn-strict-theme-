<div class="advantages-strict container">
  <div class="advantages-strict__header text-center">
    <div class="caption caption--dark">{{ section.settings.caption | default: 'THE NEOGLYN ADVANTAGE' }}</div>
    <h2>{{ section.settings.title | default: 'Clinical Precision. Home Simplicity.' }}</h2>
  </div>
  
  <div class="advantages-strict__grid">
    {% for block in section.blocks %}
      <div class="advantage-item" {{ block.shopify_attributes }}>
        <div class="advantage-icon">
          {% if block.settings.icon == 'pulse' %}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          {% elsif block.settings.icon == 'led' %}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          {% else %}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
          {% endif %}
        </div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% else %}
      <!-- Fallbacks if no blocks added -->
      <div class="advantage-item">
        <div class="advantage-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></div>
        <h3>Micro-Pulse Technology</h3>
        <p>Proprietary deep tissue stimulation that triggers natural collagen production in minutes.</p>
      </div>
      <div class="advantage-item">
        <div class="advantage-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line></svg></div>
        <h3>Tri-Wavelength LED</h3>
        <p>Targeted red, blue, and amber spectrums to address acne, aging, and inflammation simultaneously.</p>
      </div>
      <div class="advantage-item">
        <div class="advantage-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg></div>
        <h3>Dermatologist Tested</h3>
        <p>FDA-cleared technology verified by clinical trials for 45% improvement in skin elasticity.</p>
      </div>
    {% endfor %}
  </div>
</div>

<style>
.advantages-strict { padding: 100px 0; }
.advantages-strict__header { margin-bottom: 60px; }
.advantages-strict__header h2 { font-size: 36px; margin-top: 10px; }
.advantages-strict__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; text-align: center; }
.advantage-icon { width: 60px; height: 60px; background-color: var(--color-secondary-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; color: var(--color-text); }
.advantage-item h3 { font-size: 18px; margin-bottom: 16px; }
.advantage-item p { font-size: 14px; color: var(--color-text); opacity: 0.7; line-height: 1.6; max-width: 280px; margin: 0 auto; }
@media (max-width: 900px) { .advantages-strict__grid { grid-template-columns: 1fr; gap: 60px; } }
</style>

{% schema %}
{
  "name": "Advantages Strict",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "THE NEOGLYN ADVANTAGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Clinical Precision. Home Simplicity."
    }
  ],
  "blocks": [
    {
      "type": "advantage",
      "name": "Advantage",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "pulse", "label": "Lightning Pulse"},
            {"value": "led", "label": "Sun/LED"},
            {"value": "shield", "label": "Shield"}
          ],
          "default": "pulse"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New Advantage"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Description of this specific advantage."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advantages Strict",
      "blocks": [
        { "type": "advantage", "settings": {"icon": "pulse", "title": "Micro-Pulse Technology", "text": "Proprietary deep tissue stimulation."} },
        { "type": "advantage", "settings": {"icon": "led", "title": "Tri-Wavelength LED", "text": "Targeted red, blue, and amber spectrums."} },
        { "type": "advantage", "settings": {"icon": "shield", "title": "Dermatologist Tested", "text": "FDA-cleared technology verified by clinical trials."} }
      ]
    }
  ]
}
{% endschema %}
