<style>
.advantages-strict {
  padding: 100px 0;
}
.advantages-strict__header {
  margin-bottom: 60px;
}
.advantages-strict__header h2 {
  font-size: 36px;
  margin-top: 10px;
}
.advantages-strict__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  text-align: center;
}
.advantage-icon {
  width: 60px;
  height: 60px;
  background-color: var(--color-secondary-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
  color: var(--color-text);
}
.advantage-item h3 {
  font-size: 18px;
  margin-bottom: 16px;
}
.advantage-item p {
  font-size: 14px;
  color: var(--color-text);
  opacity: 0.7;
  line-height: 1.6;
  max-width: 280px;
  margin: 0 auto;
}

@media (max-width: 900px) {
  .advantages-strict__grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }
}
</style>

