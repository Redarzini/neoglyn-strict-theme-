<div class="about-hero-strict">
  <div class="container about-hero-inner">
    <div class="about-hero__content">
      <div class="caption caption--mint">{{ section.settings.hero_caption | default: 'OUR MISSION' }}</div>
      <h1>{{ section.settings.hero_title | default: 'The Science of Radiance' }}</h1>
      <p>{{ section.settings.hero_text | default: 'Redefining skincare through advanced molecular research and clinical-grade engineering. Neoglyn was founded with a singular purpose: to democratize access to dermatologist-level technology without compromising on aesthetic elegance.' }}</p>
    </div>
    <div class="about-hero__image">
      {% if section.settings.hero_image %}
        {{ section.settings.hero_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.hero_title }}
      {% else %}
        <img src="{{ 'demo-product-1.jpg' | asset_url }}" alt="Our Mission" class="radiance-img" loading="lazy" width="800" height="1200">
      {% endif %}
    </div>
  </div>
</div>

<div class="about-values-strict">
  <div class="container text-center">
    <h2>{{ section.settings.values_title | default: 'The Neoglyn Standard' }}</h2>
    <div class="values-grid">
      {% for block in section.blocks %}
        {% if block.type == 'value_item' %}
          <div class="value-item" {{ block.shopify_attributes }}>
            <div class="value-icon">{{ block.settings.icon_text | default: '01' }}</div>
            <h3>{{ block.settings.title | default: 'Core Value' }}</h3>
            <p>{{ block.settings.text | default: 'Description of this value.' }}</p>
          </div>
        {% endif %}
      {% else %}
        <!-- Fallbacks for empty state -->
        <div class="value-item">
          <div class="value-icon">01</div>
          <h3>Efficacy First</h3>
          <p>Every device is backed by independently verified clinical trials. We measure success in measurable results.</p>
        </div>
        <div class="value-item">
          <div class="value-icon">02</div>
          <h3>Precision Engineering</h3>
          <p>Built with aerospace-grade materials to ensure lifelong durability and exact wavelength output.</p>
        </div>
        <div class="value-item">
          <div class="value-icon">03</div>
          <h3>Radical Transparency</h3>
          <p>No proprietary blends or hidden mechanisms. We publish our clinical data and component sourcing.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
.about-hero-strict {
  padding: 100px 0;
}
.about-hero-inner {
  display: flex;
  align-items: center;
  gap: 80px;
}
.about-hero__content {
  flex: 1;
}
.about-hero__content h1 {
  font-size: 56px;
  line-height: 1.1;
  margin-bottom: 30px;
  letter-spacing: -1px;
}
.about-hero__content p {
  font-size: 18px;
  line-height: 1.8;
  opacity: 0.8;
}
.about-hero__image {
  flex: 1;
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  aspect-ratio: 3/4;
}
.about-hero__image img, .about-hero__image svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.about-values-strict {
  background-color: var(--color-secondary-bg);
  padding: 100px 0;
}
.about-values-strict h2 {
  font-size: 36px;
  margin-bottom: 60px;
}
.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}
.value-icon {
  font-size: 48px;
  font-weight: 800;
  color: var(--color-borders);
  line-height: 1;
  margin-bottom: 20px;
}
.value-item h3 {
  font-size: 20px;
  margin-bottom: 16px;
}
.value-item p {
  opacity: 0.7;
  line-height: 1.6;
}

@media (max-width: 900px) {
  .about-hero-inner {
    flex-direction: column;
  }
  .about-hero__content h1 {
    font-size: 40px;
  }
  .values-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }
}
</style>

{% schema %}
{
  "name": "About Strict",
  "settings": [
    {
      "type": "text",
      "id": "hero_caption",
      "label": "Hero Caption",
      "default": "OUR MISSION"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "The Science of Radiance"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero Text",
      "default": "Redefining skincare through advanced molecular research and clinical-grade engineering."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "values_title",
      "label": "Values Section Title",
      "default": "The Neoglyn Standard"
    }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Value Item",
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon/Number Text",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Value Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Describe your core value here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Strict",
      "blocks": [
        { "type": "value_item" },
        { "type": "value_item" },
        { "type": "value_item" }
      ]
    }
  ]
}
{% endschema %}
