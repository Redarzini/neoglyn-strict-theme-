<div class="hero-strict-section" style="background-color: var(--color-primary-bg); overflow: hidden;">
  <div class="container">
    <div class="hero-strict__inner">
      
      <div class="hero-strict__content">
        {% if section.settings.caption != blank %}
          <div class="caption fade-in-up" style="animation-delay: 0.1s;">
            <span class="caption-dot"></span> 
            <span>{{ section.settings.caption }}</span>
          </div>
        {% endif %}
        
        {% if section.settings.title != blank %}
          <h1 class="hero-strict__title fade-in-up" style="animation-delay: 0.2s;">
            {{ section.settings.title }}
          </h1>
        {% endif %}
        
        {% if section.settings.text != blank %}
          <p class="hero-strict__text fade-in-up" style="animation-delay: 0.3s;">
            {{ section.settings.text }}
          </p>
        {% endif %}
        
        <div class="hero-strict__actions fade-in-up" style="animation-delay: 0.4s;">
          {% if section.settings.primary_btn_text != blank %}
            <a href="{{ section.settings.primary_btn_link | default: routes.all_products_collection_url }}" class="btn">
              {{ section.settings.primary_btn_text }}
            </a>
          {% endif %}
          
          {% if section.settings.secondary_btn_text != blank %}
            <a href="{{ section.settings.secondary_btn_link | default: '#' }}" class="btn btn--outline">
              {{ section.settings.secondary_btn_text }}
            </a>
          {% endif %}
        </div>
      </div>
      
      <div class="hero-strict__image-wrapper fade-in-up" style="animation-delay: 0.5s;">
        <div class="hero-strict__image-inner">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'hero-strict__img', alt: section.settings.title, loading: 'eager' }}
          {% else %}
            <!-- Placeholder if no image is selected -->
            <div class="hero-placeholder glass-panel">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg hero-strict__img' }}
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

<style>
.hero-strict-section {
  padding: var(--spacing-2xl) 0;
  position: relative;
}

.hero-strict__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-2xl);
  min-height: 70vh;
}

.hero-strict__content {
  flex: 1;
  max-width: 540px;
  z-index: 2;
}

.hero-strict__title {
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.04em;
  color: var(--color-text);
  margin-bottom: var(--spacing-lg);
}

.hero-strict__title strong {
  color: var(--color-primary-btn);
}

.hero-strict__text {
  font-size: 1.125rem;
  line-height: 1.6;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-xl);
  max-width: 480px;
}

.hero-strict__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}

.hero-strict__image-wrapper {
  flex: 1.2;
  position: relative;
  display: flex;
  justify-content: flex-end;
  z-index: 1;
}

.hero-strict__image-inner {
  width: 100%;
  max-width: 650px;
  position: relative;
  border-radius: var(--border-radius-lg);
}

/* Subtle decorative glow behind the image matching the mint primary color */
.hero-strict__image-inner::before {
  content: '';
  position: absolute;
  top: 10%;
  left: 10%;
  right: 10%;
  bottom: 10%;
  background: var(--color-primary-btn);
  filter: blur(80px);
  opacity: 0.15;
  z-index: -1;
  border-radius: 50%;
  animation: pulse 4s infinite ease-in-out alternate;
}

.hero-strict__img {
  width: 100%;
  height: auto;
  aspect-ratio: 4/5;
  object-fit: cover;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-2xl);
}

.hero-placeholder {
  width: 100%;
  aspect-ratio: 4/5;
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

@media (max-width: 992px) {
  .hero-strict__inner {
    flex-direction: column;
    text-align: center;
    gap: var(--spacing-xl);
    padding-top: var(--spacing-xl);
  }
  
  .hero-strict__content {
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .hero-strict__text {
    margin-left: auto;
    margin-right: auto;
  }
  
  .hero-strict__actions {
    justify-content: center;
  }
  
  .hero-strict__image-wrapper {
    width: 100%;
    justify-content: center;
    margin-top: var(--spacing-lg);
  }
}
</style>

{% schema %}
{
  "name": "Hero Strict",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption Text",
      "default": "NEW CLINICAL SERIES"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Heading",
      "default": "SKIN<br>EVOLVED."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description text",
      "default": "Medical-grade micro-pulse technology meets aesthetic elegance. Experience the Neoglyn Lumina facial system from the comfort of your home."
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "LEARN THE TECH"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image",
      "info": "Upload an elegant, high-resolution product image."
    }
  ],
  "presets": [
    {
      "name": "Hero Strict (Premium)"
    }
  ]
}
{% endschema %}
