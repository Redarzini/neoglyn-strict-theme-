<div class="page-strict container">
  <header class="page-strict__header">
    <h1 class="page-strict__title">{{ page.title }}</h1>
  </header>
  
  <div class="page-strict__content rte">
    {{ page.content }}
  </div>
</div>

<style>
.page-strict {
  padding: 100px 0;
  max-width: 900px;
  margin: 0 auto;
}
.page-strict__header {
  text-align: center;
  margin-bottom: 60px;
}
.page-strict__title {
  font-size: 56px;
  letter-spacing: -1px;
}
.page-strict__content {
  font-size: 20px;
  line-height: 1.8;
  color: var(--color-text);
  opacity: 0.9;
}
@media (max-width: 768px) {
  .page-strict {
    padding: 60px 0;
  }
  .page-strict__title {
    font-size: 40px;
  }
}
</style>

{% schema %}
{
  "name": "Page strict",
  "settings": []
}
{% endschema %}
