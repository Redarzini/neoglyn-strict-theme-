<div class="dashboard-strict container">
  
  <!-- Sidebar -->
  <aside class="dashboard-sidebar">
    <div class="user-profile">
      <div class="user-avatar-large">A</div>
      <div class="user-greeting">Welcome back,<br><strong>Alex</strong></div>
    </div>
    
    <nav class="dashboard-nav">
      <a href="#" class="active">DASHBOARD</a>
      <a href="#">DEVICE METRICS</a>
      <a href="#">ORDER HISTORY</a>
      <a href="#">SETTINGS</a>
      <a href="#" class="logout-link">LOG OUT</a>
    </nav>
  </aside>

  <!-- Main Content -->
  <div class="dashboard-main">
    
    <!-- Top Stats Row -->
    <div class="dashboard-stats">
      
      <!-- Skin Score Widget -->
      <div class="stat-widget stat-widget--dark">
        <div class="stat-header">
          <span class="caption caption--mint">SKIN SCORE</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
        </div>
        <div class="score-display">
          <div class="score-number">92</div>
          <div class="score-text">OUTSTANDING<br><span class="trend">+4 PTS THIS WEEK</span></div>
        </div>
      </div>
      
      <!-- Device Status Widget -->
      <div class="stat-widget stat-widget--light">
        <div class="stat-header">
          <span class="caption">DEVICE STATUS</span>
          <span class="status-dot online"></span>
        </div>
        <h3>Neoglyn Pro</h3>
        <p>Battery: 85% • Last synced: 2h ago</p>
      </div>

    </div>

    <!-- Recent Activity -->
    <div class="dashboard-activity">
      <div class="activity-header">
        <h3>Recent Activity</h3>
        <a href="#" class="view-all">View full history</a>
      </div>
      
      <table class="activity-table">
        <thead>
          <tr>
            <th>ORDER ID</th>
            <th>DATE</th>
            <th>STATUS</th>
            <th>TOTAL</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="#">#NG-882910</a></td>
            <td>Oct 24, 2024</td>
            <td><span class="status-pill status-transit">In Transit</span></td>
            <td>$249.00</td>
          </tr>
          <tr>
            <td><a href="#">#NG-875022</a></td>
            <td>Sep 12, 2024</td>
            <td><span class="status-pill status-delivered">Delivered</span></td>
            <td>$85.00</td>
          </tr>
          <tr>
            <td><a href="#">#NG-812009</a></td>
            <td>Jan 05, 2024</td>
            <td><span class="status-pill status-delivered">Delivered</span></td>
            <td>$1,299.00</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</div>

<style>
.dashboard-strict {
  display: flex;
  gap: 60px;
  padding: 60px 0 100px;
  min-height: 80vh;
}

/* Sidebar */
.dashboard-sidebar {
  width: 280px;
  flex-shrink: 0;
  border-right: 1px solid var(--color-borders);
  padding-right: 40px;
}
.user-profile {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 60px;
}
.user-avatar-large {
  width: 60px;
  height: 60px;
  background-color: var(--color-Secondary-bg);
  border: 1px solid var(--color-borders);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 800;
  color: var(--color-text);
}
.user-greeting {
  font-size: 14px;
  color: var(--color-text);
  line-height: 1.4;
}
.user-greeting strong {
  font-size: 20px;
  font-weight: 800;
}
.dashboard-nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.dashboard-nav a {
  text-decoration: none;
  color: var(--color-text);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  padding: 16px;
  border-radius: 8px;
  transition: background-color 0.2s;
}
.dashboard-nav a:hover, .dashboard-nav a.active {
  background-color: var(--color-secondary-bg);
}
.logout-link {
  margin-top: 40px;
  opacity: 0.5;
}

/* Main Content */
.dashboard-main {
  flex: 1;
}

/* Stats */
.dashboard-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 60px;
}
.stat-widget {
  border-radius: 12px;
  padding: 30px;
}
.stat-widget--dark {
  background-color: var(--color-dark-bg);
  color: white;
}
.stat-widget--light {
  background-color: var(--color-secondary-bg);
  border: 1px solid var(--color-borders);
}
.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}
.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.status-dot.online {
  background-color: var(--color-primary-btn);
}
.score-display {
  display: flex;
  align-items: center;
  gap: 16px;
}
.score-number {
  font-size: 64px;
  font-weight: 800;
  line-height: 1;
  color: var(--color-primary-btn);
}
.score-text {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 1px;
}
.trend {
  font-size: 10px;
  color: var(--color-primary-btn);
  font-weight: 700;
}
.stat-widget--light h3 {
  font-size: 24px;
  margin-bottom: 8px;
}
.stat-widget--light p {
  font-size: 14px;
  opacity: 0.7;
  margin: 0;
}

/* Activity Table */
.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24px;
}
.activity-header h3 {
  font-size: 24px;
  margin: 0;
}
.view-all {
  font-size: 12px;
  color: var(--color-text);
  text-decoration: underline;
  font-weight: 600;
}
.activity-table {
  width: 100%;
  border-collapse: collapse;
}
.activity-table th {
  text-align: left;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--color-borders);
  color: var(--color-text);
  opacity: 0.6;
}
.activity-table td {
  padding: 24px 0;
  border-bottom: 1px solid var(--color-borders);
  font-size: 14px;
  font-weight: 500;
}
.activity-table a {
  color: var(--color-text);
  font-weight: 700;
  text-decoration: none;
}
.activity-table a:hover {
  text-decoration: underline;
}
.status-pill {
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.status-transit {
  background-color: #FFF3CD;
  color: #856404;
}
.status-delivered {
  background-color: var(--color-primary-btn);
  color: var(--color-text);
}

@media (max-width: 900px) {
  .dashboard-strict {
    flex-direction: column;
  }
  .dashboard-sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--color-borders);
    padding-right: 0;
    padding-bottom: 40px;
  }
  .dashboard-stats {
    grid-template-columns: 1fr;
  }
  .activity-table, .activity-table tbody, .activity-table tr, .activity-table td {
    display: block;
    width: 100%;
  }
  .activity-table thead {
    display: none;
  }
  .activity-table tr {
    border-bottom: 1px solid var(--color-borders);
    padding: 16px 0;
  }
  .activity-table td {
    padding: 8px 0;
    border: none;
    display: flex;
    justify-content: space-between;
  }
  .activity-table td::before {
    content: attr(data-label);
    font-weight: 700;
    font-size: 10px;
    opacity: 0.6;
    letter-spacing: 1px;
  }
}
</style>

{% schema %}
{
  "name": "Dashboard Strict",
  "settings": []
}
{% endschema %}
