<div class="dashboard-strict container">
  <aside class="dashboard-strict__sidebar">
    <div class="dashboard-strict__user-profile">
      <div class="dashboard-strict__avatar">
        {{ customer.first_name | slice: 0 | default: 'M' }}
      </div>
      <h2>{{ customer.name | default: 'Member' }}</h2>
      <p>{{ customer.email | default: 'member@neoglyn.com' }}</p>
    </div>
    <nav class="dashboard-strict__nav">
      <ul>
        <li><a href="#" class="active">Order History</a></li>
        <li><a href="#">Account Details</a></li>
        <li><a href="#">Device Warranty</a></li>
        <li><a href="{{ routes.account_logout_url }}">Log Out</a></li>
      </ul>
    </nav>
  </aside>

  <main class="dashboard-strict__main">
    <header class="dashboard-strict__header">
      <h1>Your Orders</h1>
      <p>Tracking the delivery of your clinical beauty devices.</p>
    </header>

    {% if customer.orders.size != 0 %}
      <div class="dashboard-strict__orders">
        <table>
          <thead>
            <tr>
              <th>Order</th>
              <th>Date</th>
              <th>Status</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {% for order in customer.orders %}
              <tr>
                <td>{{ order.name | link_to: order.customer_url }}</td>
                <td>{{ order.created_at | date: "%B %d, %Y" }}</td>
                <td><span class="status-badge">{{ order.fulfillment_status_label }}</span></td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="dashboard-strict__empty">
        <p>You haven't placed any orders yet. Begin your clinical beauty journey.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn">Shop Devices</a>
      </div>
    {% endif %}
  </main>
</div>

<style>
.dashboard-strict {
  display: flex;
  gap: 60px;
  padding: 80px 0;
  min-height: 70vh;
}
.dashboard-strict__sidebar {
  width: 300px;
  flex-shrink: 0;
  border-right: 2px solid var(--color-borders);
  padding-right: 40px;
}
.dashboard-strict__avatar {
  width: 80px;
  height: 80px;
  background-color: var(--color-primary-btn);
  color: var(--color-text);
  border-radius: 50%;
  border: 2px solid var(--color-borders);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  font-weight: 800;
  margin-bottom: 20px;
}
.dashboard-strict__user-profile h2 {
  font-size: 24px;
  margin-bottom: 8px;
}
.dashboard-strict__user-profile p {
  color: var(--color-text);
  opacity: 0.8;
  font-size: 14px;
  margin-bottom: 40px;
}
.dashboard-strict__nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
.dashboard-strict__nav li {
  margin-bottom: 16px;
}
.dashboard-strict__nav a {
  text-decoration: none;
  color: var(--color-text);
  font-size: 16px;
  font-weight: 600;
  display: block;
  padding: 12px 16px;
  border-radius: 4px;
  transition: all 0.2s ease;
}
.dashboard-strict__nav a:hover,
.dashboard-strict__nav a.active {
  background-color: #FAFAFA;
  border-left: 4px solid var(--color-primary-btn);
}
.dashboard-strict__main {
  flex: 1;
}
.dashboard-strict__header {
  margin-bottom: 40px;
}
.dashboard-strict__header h1 {
  font-size: 44px;
  letter-spacing: -1px;
  margin-bottom: 12px;
}
.dashboard-strict__header p {
  font-size: 18px;
  opacity: 0.9;
}
.dashboard-strict__orders table {
  width: 100%;
  border-collapse: collapse;
}
.dashboard-strict__orders th {
  text-align: left;
  padding: 20px;
  background-color: #FAFAFA;
  border-bottom: 2px solid var(--color-borders);
  font-weight: 700;
  text-transform: uppercase;
  font-size: 14px;
  letter-spacing: 1px;
}
.dashboard-strict__orders td {
  padding: 20px;
  border-bottom: 1px solid rgba(0,31,63,0.1);
  font-size: 16px;
  font-weight: 500;
}
.status-badge {
  background-color: var(--color-primary-btn);
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  border: 1px solid var(--color-borders);
}
.dashboard-strict__empty {
  text-align: center;
  padding: 80px 0;
  background-color: #FAFAFA;
  border: 1px dashed var(--color-borders);
  border-radius: 4px;
}
.dashboard-strict__empty p {
  font-size: 20px;
  margin-bottom: 30px;
}
@media (max-width: 990px) {
  .dashboard-strict {
    flex-direction: column;
    padding: 40px 0;
  }
  .dashboard-strict__sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 2px solid var(--color-borders);
    padding-right: 0;
    padding-bottom: 40px;
  }
  .dashboard-strict__orders th, 
  .dashboard-strict__orders td {
    padding: 15px 10px;
  }
}
</style>

{% schema %}
{
  "name": "Dashboard strict",
  "settings": []
}
{% endschema %}
