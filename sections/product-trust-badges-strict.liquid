<div class="trust-badges-strict">
  <div class="container trust-badges-inner">
    
    <div class="trust-badge">
      <div class="trust-badge__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <div class="trust-badge__title">FDA CLEARED</div>
    </div>
    
    <div class="trust-badge">
      <div class="trust-badge__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><line x1="12" y1="22" x2="12" y2="12"></line><line x1="12" y1="12" x2="21.5" y2="6.5"></line><line x1="12" y1="12" x2="2.5" y2="6.5"></line></svg>
      </div>
      <div class="trust-badge__title">CRUELTY FREE</div>
    </div>
    
    <div class="trust-badge">
      <div class="trust-badge__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
      </div>
      <div class="trust-badge__title">FREE SHIPPING</div>
    </div>
    
    <div class="trust-badge">
      <div class="trust-badge__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
      </div>
      <div class="trust-badge__title">2 YEAR WARRANTY</div>
    </div>
    
  </div>
</div>

<style>
.trust-badges-strict {
  border-top: 1px solid var(--color-borders);
  border-bottom: 1px solid var(--color-borders);
  padding: 60px 0;
  margin-top: 60px;
}
.trust-badges-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: center;
}
.trust-badge {
  flex: 1;
}
.trust-badge__icon {
  color: var(--color-primary-btn);
  margin-bottom: 16px;
}
.trust-badge__icon svg {
  width: 32px;
  height: 32px;
}
.trust-badge__title {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.5px;
  color: var(--color-text);
  text-transform: uppercase;
}
@media (max-width: 768px) {
  .trust-badges-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
}
</style>

