<div class="trust-badges-strict">
  <div class="container">
    <div class="trust-badges-inner">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="trust-badge fade-in-up" style="animation-delay: {{ forloop.index | times: 0.1 }}s;" {{ block.shopify_attributes }}>
            <div class="trust-badge__icon-wrapper">
              {% if block.settings.custom_svg != blank %}
                <div class="trust-badge__icon">
                  {{ block.settings.custom_svg }}
                </div>
              {% elsif block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 64 | image_tag: class: 'trust-badge__img', loading: 'lazy' }}
              {% else %}
                <div class="trust-badge__icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
                </div>
              {% endif %}
            </div>
            
            {% if block.settings.title != blank %}
              <div class="trust-badge__title">{{ block.settings.title }}</div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Default State for Theme Editor -->
        <div class="trust-badge"><div class="trust-badge__title">ADD BADGES IN EDITOR</div></div>
      {% endif %}
    </div>
  </div>
</div>

<style>
.trust-badges-strict {
  border-top: 1px solid var(--color-borders);
  border-bottom: 1px solid var(--color-borders);
  padding: var(--spacing-2xl) 0;
  margin-top: var(--spacing-lg);
  background-color: var(--color-primary-bg);
}

.trust-badges-inner {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  text-align: center;
  gap: var(--spacing-md);
  flex-wrap: wrap;
}

.trust-badge {
  flex: 1;
  min-width: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.3s ease;
}

.trust-badge:hover {
  transform: translateY(-5px);
}

.trust-badge__icon-wrapper {
  margin-bottom: var(--spacing-md);
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--color-secondary-bg);
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
  transition: all 0.3s ease;
}

.trust-badge:hover .trust-badge__icon-wrapper {
  background: var(--color-primary-btn);
  color: var(--color-primary-bg);
  box-shadow: 0 10px 15px -3px rgba(130, 217, 185, 0.4);
}

.trust-badge__icon {
  color: var(--color-text);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.3s ease;
}

.trust-badge__icon svg {
  width: 32px;
  height: 32px;
}

.trust-badge:hover .trust-badge__icon {
  color: var(--color-primary-bg);
}

.trust-badge__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 50%;
  padding: 12px;
}

.trust-badge__title {
  font-size: 0.75rem;
  font-family: var(--font-heading);
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--color-text);
  text-transform: uppercase;
  max-width: 160px;
}

@media (max-width: 768px) {
  .trust-badges-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl) var(--spacing-md);
  }
}

@media (max-width: 480px) {
  .trust-badges-inner {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
