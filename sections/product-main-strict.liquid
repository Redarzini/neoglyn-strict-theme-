<div class="product-main-strict container">
  <!-- Left Side: Product Imagery -->
  <div class="product-main-strict__gallery">
    <div class="product-main-strict__hero-image">
      <img src="https://via.placeholder.com/600x600/E0EBEB/001F3F?text=Neoglyn+Pro+Advanced+Device" alt="Neoglyn Pro Advanced - Midnight Blue Edition">
    </div>
    <div class="product-main-strict__thumbnails">
      <img src="https://via.placeholder.com/150x150/E0EBEB/001F3F?text=Thumb1" alt="Thumbnail 1" class="active">
      <img src="https://via.placeholder.com/150x150/EAEAEA/001F3F?text=Thumb2" alt="Thumbnail 2">
      <img src="https://via.placeholder.com/150x150/111111/FFFFFF?text=Thumb3" alt="Thumbnail 3">
      <div class="thumb-extra">+2</div>
    </div>
  </div>
  
  <!-- Right Side: Product Details -->
  <div class="product-main-strict__info">
    <div class="caption caption--mint">EDITOR'S CHOICE 2024</div>
    <h1 class="product-main-strict__title">Neoglyn Pro Advanced</h1>
    
    <div class="product-reviews">
      <div class="stars">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      </div>
      <span class="review-text">4.8 (2,492 Reviews)</span>
    </div>

    <div class="product-price-block">
      <span class="product-price">$249.00</span>
      <span class="product-price-compare">$320.00</span>
    </div>

    <div class="product-description">
      <p>Revolutionize your skincare routine with the Midnight Blue Edition. Professional-grade microcurrent and red-light therapy, engineered for visible rejuvenation in just 5 minutes a day.</p>
    </div>
    
    <div class="product-features-checklist">
      <ul>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> 94% report firmer skin in 2 weeks</li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Dual-action microcurrent technology</li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> NASA-inspired Red Light Therapy</li>
      </ul>
    </div>

    <!-- Shopify Add to Cart Form for Teamdrop Sync -->
    {% form 'product', product, id: 'add-to-cart-form', class: 'product-form-strict' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" name="add" id="AddToCart" class="btn product-add-button">
        ADD TO CART <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </button>
    {% endform %}
    
    <div class="product-payment-icons">
      <svg width="32" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
      <svg width="32" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      <svg width="32" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
    </div>

    <div class="product-accordions">
      <div class="accordion-item">
        <button class="accordion-header">CLINICAL PROOF <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">HOW TO USE <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
      </div>
      <div class="accordion-item">
        <button class="accordion-header">SHIPPING & RETURNS <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
      </div>
    </div>

  </div>
</div>

<style>
.product-main-strict {
  display: flex;
  gap: 60px;
  padding: 60px 0;
  align-items: flex-start;
}
.product-main-strict__gallery {
  width: 50%;
}
.product-main-strict__hero-image {
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 16px;
  aspect-ratio: 1;
}
.product-main-strict__hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.product-main-strict__thumbnails {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.product-main-strict__thumbnails img, .thumb-extra {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8px;
  object-fit: cover;
  cursor: pointer;
  border: 2px solid transparent;
}
.product-main-strict__thumbnails img.active {
  border-color: var(--color-primary-btn);
}
.thumb-extra {
  background-color: #F0CDC0; /* Match screenshot color */
  color: var(--color-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
}

.product-main-strict__info {
  width: 50%;
}
.caption--mint {
  color: var(--color-primary-btn);
  margin-bottom: 8px;
}
.product-main-strict__title {
  font-size: 48px;
  letter-spacing: -1px;
  margin-bottom: 16px;
  line-height: 1.1;
}
.product-reviews {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}
.stars {
  color: var(--color-primary-btn);
  display: flex;
  gap: 2px;
}
.review-text {
  font-size: 14px;
  color: var(--color-text);
  font-weight: 600;
  opacity: 0.8;
}
.product-price-block {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 30px;
}
.product-price {
  font-size: 32px;
  font-weight: 800;
}
.product-price-compare {
  font-size: 20px;
  text-decoration: line-through;
  opacity: 0.5;
  font-weight: 600;
}
.product-description {
  font-size: 16px;
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 30px;
}
.product-features-checklist ul {
  list-style: none;
  padding: 0;
  margin: 0 0 40px 0;
}
.product-features-checklist li {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  font-size: 14px;
  font-weight: 600;
}
.product-features-checklist svg {
  color: var(--color-primary-btn);
}
.product-add-button {
  width: 100%;
  padding: 18px;
  font-size: 16px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  border-radius: 8px; /* Slightly squarer than full pill here */
}
.product-payment-icons {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin: 30px 0 40px;
  color: var(--color-text);
  opacity: 0.6;
}
.product-accordions {
  border-top: 1px solid var(--color-borders);
}
.accordion-item {
  border-bottom: 1px solid var(--color-borders);
}
.accordion-header {
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: 24px 0;
  font-size: 14px;
  font-weight: 800;
  color: var(--color-text);
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

@media (max-width: 900px) {
  .product-main-strict {
    flex-direction: column;
  }
  .product-main-strict__gallery, 
  .product-main-strict__info {
    width: 100%;
  }
  .product-main-strict__title {
    font-size: 36px;
  }
}
</style>

{% schema %}
{
  "name": "Product strict",
  "settings": []
}
{% endschema %}
