<div class="product-page-container container section-padding">
  
  <nav class="product-breadcrumbs fade-in-up" aria-label="breadcrumbs">
    <a href="{{ routes.root_url }}" title="Home">Home</a> <span>/</span>
    <a href="{{ routes.all_products_collection_url }}" title="Products">Devices</a> <span>/</span>
    <span class="breadcrumb-current">{{ product.title | default: 'Neoglyn Pro Advanced' }}</span>
  </nav>

  <div class="product-grid">
    <!-- Left Side: Product Imagery -->
    <div class="product-gallery fade-in-up" style="animation-delay: 100ms;">
      {% if product.media.size > 0 %}
        <div class="product-main-image-wrapper">
          {% assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media %}
          {{ featured_media | image_url: width: 1000 | image_tag: alt: featured_media.alt, class: 'product-main-img', id: 'MainProductImage' }}
        </div>
        
        {% if product.media.size > 1 %}
          <div class="product-thumbnails">
            {% for media in product.media limit: 5 %}
              <div class="product-thumb {% if media.id == featured_media.id %}is-active{% endif %}" data-media-id="{{ media.id }}">
                {{ media | image_url: width: 250 | image_tag: alt: media.alt }}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="product-main-image-wrapper">
          {{ 'product-1' | placeholder_svg_tag: 'product-main-img placeholder-svg' }}
        </div>
      {% endif %}
    </div>
    
    <!-- Right Side: Product Details -->
    <div class="product-info fade-in-up" style="animation-delay: 200ms;">
      
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            <h1 class="product-title" {{ block.shopify_attributes }}>
              {{ product.title | default: 'Neoglyn Pro Advanced' }}
            </h1>
            
          {% when 'price' %}
            <div class="product-price-wrapper" {{ block.shopify_attributes }}>
              {% assign price = product.selected_or_first_available_variant.price %}
              {% assign compare_at_price = product.selected_or_first_available_variant.compare_at_price %}
              
              <span class="product-price">
                {{ price | money | default: '$249.00' }}
              </span>
              {% if compare_at_price and compare_at_price > price %}
                <span class="product-compare-price" style="text-decoration: line-through; opacity: 0.5; margin-left: 8px;">
                  {{ compare_at_price | money }}
                </span>
              {% endif %}
            </div>

          {% when 'reviews' %}
            <div class="product-reviews" {{ block.shopify_attributes }}>
              <div class="stars">
                {% for i in (1..5) %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                {% endfor %}
              </div>
              <a href="#reviews" class="review-link">{{ block.settings.review_text | default: '4.9 / 5 (320 Reviews)' }}</a>
            </div>

          {% when 'description' %}
            <div class="product-description" {{ block.shopify_attributes }}>
              {% if product.description != blank %}
                {{ product.description }}
              {% else %}
                <p>The ultimate clinical-grade LED light therapy mask. Engineered to penetrate deep into the skin's layers to trigger cellular repair, boost collagen production, and reduce inflammation.</p>
              {% endif %}
            </div>
            
          {% when 'variant_picker' %}
            <div class="product-variants" {{ block.shopify_attributes }}>
              {% if product.variants.size > 1 %}
                <p class="variant-label">Color: <span class="variant-selected">Midnight Blue</span></p>
                <div class="color-swatches">
                  <div class="swatch" style="background-color: #001f3f;" aria-label="Midnight Blue"></div>
                  <div class="swatch" style="background-color: #82D9B9;" aria-label="Mint"></div>
                </div>
              {% else %}
                <p class="variant-label">Color: <span class="variant-selected">Midnight Blue</span></p>
                <div class="color-swatches">
                  <div class="swatch active" style="background-color: #081a2e;"></div>
                  <div class="swatch" style="background-color: #7cdcac;"></div>
                </div>
              {% endif %}
            </div>

          {% when 'included_text' %}
            <div class="product-included" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text | default: 'Includes Charging Base & Protective Case' }}</p>
            </div>

          {% when 'buy_buttons' %}
            <div class="product-form-container" {{ block.shopify_attributes }}>
              {% form 'product', product, id: 'add-to-cart-form', class: 'product-form' %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: 1 }}">
                
                <button type="submit" name="add" class="btn product-add-btn" {% unless product.available %}disabled="disabled"{% endunless %}>
                  {% if product.available or product.title == blank %}
                    Add to Cart - {{ product.selected_or_first_available_variant.price | money | default: '$249.00' }}
                  {% else %}
                    Sold Out
                  {% endif %}
                </button>
              {% endform %}
            </div>

          {% when 'accordion' %}
            <div class="product-accordion-wrapper" {{ block.shopify_attributes }}>
              <details class="product-accordion-item">
                <summary class="product-accordion-header">
                  {{ block.settings.heading | default: 'Benefits' }}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </summary>
                <div class="product-accordion-content">
                  {{ block.settings.content | default: '<p>Reduces fine lines and wrinkles. Kills acne-causing bacteria. Promotes a healthy, glowing complexion.</p>' }}
                </div>
              </details>
            </div>
        {% endcase %}
      {% endfor %}

    </div>
  </div>
</div>

<style>
.product-page-container {
  max-width: 1200px;
}

.product-breadcrumbs {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-xl);
  font-family: var(--font-body);
}

.product-breadcrumbs a {
  color: var(--color-text-muted);
  text-decoration: none;
  transition: var(--color-primary-btn);
}

.product-breadcrumbs a:hover {
  color: var(--color-primary-btn);
}

.product-breadcrumbs span {
  margin: 0 8px;
  color: var(--color-text-muted);
  opacity: 0.5;
}

.breadcrumb-current {
  color: var(--color-heading);
  font-weight: 600;
  margin: 0 !important;
  opacity: 1 !important;
}

.product-grid {
  display: flex;
  gap: 80px;
  align-items: flex-start;
}

.product-gallery {
  width: 50%;
  position: sticky;
  top: 100px;
}

.product-main-image-wrapper {
  background-color: var(--color-secondary-bg);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  margin-bottom: var(--spacing-lg);
  aspect-ratio: 1;
}

.product-main-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: multiply; /* Helps white background images blend with gray bg */
}

.product-thumbnails {
  display: flex;
  gap: var(--spacing-md);
}

.product-thumb {
  width: 80px;
  height: 80px;
  background-color: var(--color-secondary-bg);
  border-radius: var(--border-radius-sm);
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition: var(--transition-smooth);
}

.product-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: multiply;
}

.product-thumb.is-active,
.product-thumb:hover {
  border-color: var(--color-borders);
}

.product-info {
  width: 50%;
  padding-top: var(--spacing-md);
}

.product-title {
  font-size: 2.5rem;
  line-height: 1.1;
  color: var(--color-heading);
  margin-bottom: var(--spacing-sm);
}

.product-price-wrapper {
  margin-bottom: var(--spacing-md);
}

.product-price {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-heading);
}

.product-reviews {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: var(--spacing-lg);
}

.stars {
  color: var(--color-primary-btn);
  display: flex;
  gap: 2px;
}

.review-link {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-text-muted);
  text-decoration: none;
}

.review-link:hover {
  text-decoration: underline;
}

.product-description {
  font-size: 1rem;
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: var(--spacing-xl);
}

.product-variants {
  margin-bottom: var(--spacing-lg);
}

.variant-label {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--color-heading);
  margin-bottom: var(--spacing-sm);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.variant-selected {
  font-weight: 500;
  color: var(--color-text-muted);
  text-transform: none;
  letter-spacing: 0;
}

.color-swatches {
  display: flex;
  gap: 12px;
}

.swatch {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid var(--color-primary-bg);
  box-shadow: 0 0 0 1px var(--color-borders);
  transition: var(--transition-smooth);
}

.swatch.active,
.swatch:hover {
  box-shadow: 0 0 0 2px var(--color-heading);
}

.product-included {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  font-weight: 500;
  margin-bottom: var(--spacing-xl);
}

.product-form-container {
  margin-bottom: var(--spacing-2xl);
}

.product-add-btn {
  width: 100%;
  padding: 18px;
  font-size: 1.125rem;
}

.product-accordion-wrapper {
  border-top: 1px solid var(--color-borders);
}

.product-accordion-item {
  border-bottom: 1px solid var(--color-borders);
}

.product-accordion-header {
  width: 100%;
  padding: 24px 0;
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-heading);
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  list-style: none;
}

.product-accordion-header::-webkit-details-marker {
  display: none;
}

.product-accordion-content {
  padding-bottom: 24px;
  color: var(--color-text-muted);
  line-height: 1.6;
  font-size: 0.95rem;
}

@media (max-width: 900px) {
  .product-grid {
    flex-direction: column;
    gap: 40px;
  }
  .product-gallery, .product-info {
    width: 100%;
  }
  .product-gallery {
    position: static;
  }
}
</style>

{% schema %}
{
  "name": "Product Main Strict",
  "settings": [],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "review_text",
          "label": "Review Text",
          "default": "4.9 / 5 (320 Reviews)"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Color Swatches",
      "limit": 1
    },
    {
      "type": "included_text",
      "name": "Included Items Text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Includes Charging Base & Protective Case"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Button",
      "limit": 1
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Benefits"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Main Strict",
      "blocks": [
        { "type": "title" },
        { "type": "price" },
        { "type": "reviews" },
        { "type": "description" },
        { "type": "variant_picker" },
        { "type": "included_text" },
        { "type": "buy_buttons" },
        { "type": "accordion", "settings": { "heading": "Benefits" } },
        { "type": "accordion", "settings": { "heading": "How to Use" } },
        { "type": "accordion", "settings": { "heading": "Clinical specifications" } }
      ]
    }
  ]
}
{% endschema %}
