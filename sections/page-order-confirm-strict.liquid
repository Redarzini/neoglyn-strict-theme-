<div class="order-confirm-page container section-padding text-center">
  <h1 class="confirm-title fade-in-up">Thank You!</h1>
  
  <div class="confirm-card glass-panel fade-in-up" style="animation-delay: 100ms;">
    
    <div class="confirm-icon-wrapper">
      <div class="confirm-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
    </div>
    
    <h2 class="confirm-heading">Your Order is Confirmed</h2>
    <p class="confirm-subtitle">We've received your order and are currently processing it.</p>
    
    <div class="order-details-box">
      <div class="detail-item">
        <span class="detail-label">Order #</span>
        <span class="detail-value">NG-882910</span>
      </div>
      <div class="detail-item">
        <span class="detail-label">Date</span>
        <span class="detail-value">{{ 'now' | date: "%B %d, %Y" }}</span>
      </div>
      <div class="detail-item">
        <span class="detail-label">Total</span>
        <span class="detail-value">$249.00</span>
      </div>
    </div>
    
    <p class="confirm-note">You will receive an email confirmation containing your receipt and tracking information once your order has shipped.</p>
    
    <a href="{{ routes.collections_url }}" class="btn confirm-btn">Continue Shopping</a>
    
  </div>
</div>

<style>
.order-confirm-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  background-color: var(--color-primary-bg);
}

.confirm-title {
  font-size: 3.5rem;
  font-weight: 800;
  color: var(--color-heading);
  margin-bottom: var(--spacing-xl);
  letter-spacing: -0.02em;
}

.confirm-card {
  max-width: 540px;
  width: 100%;
  padding: 60px;
  border-radius: var(--border-radius-xl);
  background: var(--color-primary-bg);
  border: 1px solid var(--color-borders);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.confirm-icon-wrapper {
  margin-bottom: var(--spacing-lg);
}

.confirm-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background-color: var(--color-secondary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary-btn);
}

.confirm-icon svg {
  width: 40px;
  height: 40px;
}

.confirm-heading {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--color-heading);
  margin-bottom: var(--spacing-sm);
}

.confirm-subtitle {
  font-size: 1rem;
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-xl);
}

.order-details-box {
  width: 100%;
  background-color: var(--color-secondary-bg);
  border-radius: var(--border-radius-md);
  padding: 24px;
  display: flex;
  justify-content: space-between;
  text-align: left;
  margin-bottom: var(--spacing-xl);
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.detail-label {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.detail-value {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-heading);
}

.confirm-note {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.6;
  margin-bottom: var(--spacing-xl);
  opacity: 0.8;
}

.confirm-btn {
  width: 100%;
  padding: 16px;
  font-size: 1rem;
  font-weight: 700;
}

@media (max-width: 600px) {
  .confirm-title {
    font-size: 2.5rem;
  }
  .confirm-card {
    padding: 32px 20px;
  }
  .order-details-box {
    flex-direction: column;
    gap: 16px;
  }
}
</style>

{% schema %}
{
  "name": "Order Confirm Strict",
  "settings": []
}
{% endschema %}
