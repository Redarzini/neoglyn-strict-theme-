<div class="clinical-results-wrapper">
  <div class="clinical-results-strict container">
    <div class="results-layout">
      
      <!-- Left side: Images -->
      <div class="results-images">
        <div class="results-card results-card--before">
          <div class="results-card__badge">DAY 1</div>
          <div class="results-card__placeholder">BEFORE DEVICE INTERVENTION</div>
        </div>
        
        <div class="results-card results-card--after">
          <div class="results-card__badge results-card__badge--mint">DAY 30</div>
          <div class="results-card__image-container">
            <img src="https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?q=80&w=800&auto=format&fit=crop/FFFFFF/001F3F?text=After" alt="After 30 days">
          </div>
          
          <div class="results-stats-overlay">
            <div class="stat-box">
              <div class="stat-number">-45%</div>
              <div class="stat-label">WRINKLE DEPTH</div>
            </div>
            <div class="stat-box stat-box--highlight">
              <div class="stat-number">+82%</div>
              <div class="stat-label">SKIN LUMINOSITY</div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Right side: Text Content -->
      <div class="results-content">
        <div class="caption caption--mint">CLINICAL RESULTS</div>
        <h2 class="results-content__title">Real people.<br>Verified data.</h2>
        
        <div class="results-quote">
          <p>"I was skeptical about home devices, but after 30 days of consistent Lumina use, my jawline is more defined and the fine lines around my eyes have visibly softened."</p>
        </div>
        
        <div class="results-user">
          <div class="user-avatar"></div>
          <div>
            <div class="user-name">Sarah Jenkins</div>
            <div class="user-desc">VERIFIED USER • 4 WEEKS</div>
          </div>
        </div>
        
        <a href="/pages/science" class="results-link">SEE MORE CASE STUDIES <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
      
    </div>
  </div>
</div>

<style>
.clinical-results-wrapper {
  background-color: var(--color-dark-bg);
  color: var(--color-dark-text);
  padding: 100px 0;
  border-top-left-radius: 60px;
  border-top-right-radius: 60px;
  margin-top: 60px;
}
.clinical-results-strict h2 {
  color: var(--color-dark-text);
}
.results-layout {
  display: flex;
  align-items: center;
  gap: 80px;
}
.results-images {
  flex: 1;
  position: relative;
  display: flex;
  gap: 20px;
  align-items: flex-start;
}
.results-card {
  flex: 1;
  border-radius: 12px;
  position: relative;
  overflow: hidden;
}
.results-card--before {
  background-color: #E6E6E6;
  aspect-ratio: 3/4;
  margin-top: 40px;
}
.results-card--after {
  background-color: #FFFFFF;
  margin-bottom: 40px;
}
.results-card__image-container {
  aspect-ratio: 3/4;
}
.results-card__image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.results-card__placeholder {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  color: var(--color-text);
  font-size: 10px;
  letter-spacing: 1px;
  font-weight: 700;
}
.results-card__badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background-color: rgba(0,0,0,0.4);
  color: white;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  z-index: 10;
}
.results-card__badge--mint {
  background-color: var(--color-primary-btn);
  color: var(--color-text);
}

.results-stats-overlay {
  position: absolute;
  bottom: -40px;
  left: -20px; /* Overlap effect from the screenshot */
  right: 0;
  display: flex;
.clinical-strict { background-color: var(--color-dark-bg, #001F3F); color: white; padding: 120px 0; overflow: hidden; }
.clinical-strict__inner { display: flex; align-items: center; gap: 80px; }
.clinical-content { flex: 1; }
.clinical-content h2 { font-size: 40px; margin: 16px 0 24px; color: white; line-height: 1.1; }
.clinical-content p { font-size: 16px; opacity: 0.8; margin-bottom: 40px; line-height: 1.6; }
.clinical-stats { list-style: none; padding: 0; margin: 0 0 40px 0; border-top: 1px solid rgba(255,255,255,0.1); }
.clinical-stats li { display: flex; align-items: flex-start; gap: 24px; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }
.clinical-stats strong { font-size: 32px; color: var(--color-primary-btn); line-height: 1; }
.clinical-stats span { font-size: 14px; opacity: 0.9; line-height: 1.5; }
.clinical-image { flex: 1; position: relative; }
.clip-image { border-radius: 20px; box-shadow: 0 40px 80px rgba(0,0,0,0.3); width: 100%; height: auto; display: block; }
@media (max-width: 900px) { .clinical-strict__inner { flex-direction: column; } }
</style>

{% schema %}
{
  "name": "Clinical Results Strict",
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "VERIFIED EFFICACY" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Clinical Results, Validated by Science" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "In an independent 8-week clinical study..." },
    { "type": "text", "id": "stat_1", "label": "Stat 1 Number", "default": "94%" },
    { "type": "text", "id": "stat_1_text", "label": "Stat 1 Text", "default": "Saw a visible reduction in fine lines and wrinkles." },
    { "type": "text", "id": "stat_2", "label": "Stat 2 Number", "default": "88%" },
    { "type": "text", "id": "stat_2_text", "label": "Stat 2 Text", "default": "Experienced a clearer, more even skin tone and reduced redness." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "READ THE STUDY" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [ { "name": "Clinical Results Strict" } ]
}
{% endschema %}
