<div class="track-order-page container glass-panel">
  <div class="track-order-card text-center fade-in-up">
    
    <div class="track-order-header">
      <h1 class="track-order-title">{{ section.settings.title | default: 'Track Your Order' }}</h1>
      <p class="track-order-subtitle">{{ section.settings.subtitle | default: 'Enter your details below to see the real-time status of your shipment.' }}</p>
    </div>

    <div class="track-form-container">
      <form class="track-form" action="#" method="GET">
        <label for="tracking-number" class="track-label">{{ section.settings.form_label | default: 'ORDER OR TRACKING NUMBER' }}</label>
        <div class="input-with-icon">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="tracking-number" name="q" placeholder="{{ section.settings.form_placeholder | default: 'e.g. NG-88231 or 1Z999...' }}" required>
        </div>
        <button type="button" class="btn btn-track">{{ section.settings.button_text | default: 'Track Package' }}</button>
      </form>
      
      <div class="track-help">
        <p>{{ section.settings.support_text | default: 'Need help with your shipment?' }} <a href="{{ section.settings.support_link | default: routes.root_url }}" class="support-link">Contact Support</a></p>
      </div>
    </div>

    <div class="track-features">
      {% for block in section.blocks %}
        <div class="feature-item" {{ block.shopify_attributes }}>
          <div class="feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <span class="feature-title">{{ block.settings.title | default: 'FEATURE' }}</span>
        </div>
      {% else %}
        <div class="feature-item">
          <div class="feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
          </div>
          <span class="feature-title">SECURE</span>
        </div>
        <div class="feature-item">
          <div class="feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <span class="feature-title">REAL-TIME</span>
        </div>
        <div class="feature-item">
          <div class="feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </div>
          <span class="feature-title">GLOBAL</span>
        </div>
      {% endfor %}
    </div>

  </div>

  <div class="track-footer text-center">
    <p>&copy; {{ 'now' | date: '%Y' }} Neoglyn Logistics. All rights reserved.</p>
  </div>
</div>

<style>
.track-order-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: var(--spacing-3xl) var(--spacing-lg);
  background-color: var(--color-primary-bg); /* Matching screenshot pure background */
  border: none;
  box-shadow: none;
}

.track-order-card {
  background: var(--color-primary-bg);
  border: 1px solid var(--color-borders);
  border-radius: var(--border-radius-lg);
  padding: 60px 80px;
  max-width: 600px;
  width: 100%;
  box-shadow: var(--shadow-sm);
}

.track-order-title {
  font-size: 2.25rem;
  font-weight: 800;
  color: var(--color-heading);
  margin-bottom: var(--spacing-sm);
  letter-spacing: -0.02em;
}

.track-order-subtitle {
  color: var(--color-text-muted);
  font-size: 1rem;
  line-height: 1.5;
  margin-bottom: var(--spacing-2xl);
}

.track-form-container {
  width: 100%;
}

.track-form {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  text-align: left;
}

.track-label {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  color: var(--color-heading);
  text-transform: uppercase;
}

.input-with-icon {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 16px;
  color: var(--color-text-muted);
  opacity: 0.6;
}

.input-with-icon input {
  width: 100%;
  padding: 16px 16px 16px 48px;
  border: 1px solid var(--color-borders);
  border-radius: var(--border-radius-sm);
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--color-heading);
  transition: var(--transition-smooth);
}

.input-with-icon input:focus {
  outline: none;
  border-color: var(--color-primary-btn);
  box-shadow: 0 0 0 2px rgba(124, 220, 172, 0.2);
}

.input-with-icon input::placeholder {
  color: var(--color-text-muted);
  opacity: 0.6;
}

.btn-track {
  width: 100%;
  background-color: var(--color-primary-btn);
  color: var(--color-heading);
  padding: 16px;
  border-radius: var(--border-radius-sm);
  font-size: 1rem;
  font-weight: 700;
  margin-top: var(--spacing-lg);
}

.track-help {
  margin-top: var(--spacing-xl);
  font-size: 0.875rem;
  color: var(--color-text-muted);
}

.support-link {
  color: var(--color-heading);
  font-weight: 700;
  text-decoration: none;
  border-bottom: 2px solid var(--color-primary-btn);
  padding-bottom: 2px;
  transition: var(--transition-smooth);
}

.support-link:hover {
  color: var(--color-primary-btn);
}

.track-features {
  display: flex;
  justify-content: space-center;
  gap: 40px;
  margin-top: 50px;
  padding-top: 40px;
  border-top: 1px solid var(--color-borders);
  color: var(--color-text-muted);
  opacity: 0.6;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.feature-title {
  font-family: var(--font-heading);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.track-footer {
  margin-top: var(--spacing-2xl);
  font-size: 0.75rem;
  color: var(--color-text-muted);
  opacity: 0.6;
}

@media (max-width: 768px) {
  .track-order-card {
    padding: 40px 24px;
  }
  .track-features {
    gap: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Track Order Strict",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Track Your Order"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Enter your details below to see the real-time status of your shipment."
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Form Label",
      "default": "ORDER OR TRACKING NUMBER"
    },
    {
      "type": "text",
      "id": "form_placeholder",
      "label": "Input Placeholder",
      "default": "e.g. NG-88231 or 1Z999..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Track Package"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support Text",
      "default": "Need help with your shipment?"
    },
    {
      "type": "url",
      "id": "support_link",
      "label": "Support Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "SECURE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Track Order Strict",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
