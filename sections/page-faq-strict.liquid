<div class="faq-strict container">
  
  <div class="faq-strict__header">
    <div class="caption caption--mint">{{ section.settings.caption }}</div>
    <h1>{{ section.settings.title }}</h1>
  </div>

  <div class="faq-layout">
    
    <div class="faq-main">
      <div class="faq-accordion">
        
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <div class="faq-item {% if forloop.first %}open{% endif %}" {{ block.shopify_attributes }}>
              <button class="faq-question">
                <span>{{ block.settings.question }}</span>
                <svg class="icon-plus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <svg class="icon-minus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </button>
              <div class="faq-answer">
                <p>{{ block.settings.answer }}</p>
              </div>
            </div>
          {% endif %}
        {% else %}
          <!-- Fallback when no blocks added -->
          <div class="faq-item open">
            <button class="faq-question">
              <span>Is the Neoglyn Lumina safe for all skin types?</span>
              <svg class="icon-plus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <svg class="icon-minus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </button>
            <div class="faq-answer">
              <p>Yes. The Neoglyn Lumina uses non-UV LED light and micro-pulse technology that is FDA-cleared and dermatologist-tested to be safe for all skin tones and types, including sensitive skin.</p>
            </div>
          </div>
        {% endfor %}

      </div>
    </div>

    <!-- Sidebar Support -->
    <aside class="faq-sidebar">
      <div class="support-card">
        <h3>{{ section.settings.sidebar_title }}</h3>
        <p>{{ section.settings.sidebar_text }}</p>
        <a href="{{ section.settings.btn_link | default: routes.root_url }}" class="btn btn--block">{{ section.settings.btn_text }}</a>
        
        <div class="support-contact-info">
          <p><strong>Email:</strong> {{ section.settings.email }}</p>
          <p><strong>Hours:</strong> {{ section.settings.hours }}</p>
        </div>
      </div>
    </aside>

  </div>
</div>

<style>
.faq-strict {
  padding: 80px 0 120px;
}
.faq-strict__header {
  margin-bottom: 60px;
}
.faq-strict__header h1 {
  font-size: 48px;
  line-height: 1.1;
  letter-spacing: -1px;
}
.faq-layout {
  display: flex;
  gap: 80px;
  align-items: flex-start;
}
.faq-main {
  flex: 1;
}
.faq-accordion {
  border-top: 2px solid var(--color-borders);
}
.faq-item {
  border-bottom: 1px solid var(--color-borders);
}
.faq-question {
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: 24px 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--color-text);
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  letter-spacing: -0.5px;
}
.icon-minus {
  display: none;
}
.faq-item.open .icon-plus {
  display: none;
}
.faq-item.open .icon-minus {
  display: block;
}
.faq-answer {
  display: none;
  padding-bottom: 30px;
  color: var(--color-text);
  font-size: 16px;
  line-height: 1.8;
  opacity: 0.8;
  max-width: 90%;
}
.faq-item.open .faq-answer {
  display: block;
}

/* Sidebar */
.faq-sidebar {
  width: 320px;
  flex-shrink: 0;
}
.support-card {
  background-color: var(--color-secondary-bg);
  padding: 40px;
  border-radius: 12px;
}
.support-card h3 {
  font-size: 20px;
  margin-bottom: 12px;
}
.support-card p {
  font-size: 14px;
  opacity: 0.8;
  line-height: 1.6;
  margin-bottom: 24px;
}
.btn--block {
  width: 100%;
  display: block;
  margin-bottom: 30px;
}
.support-contact-info {
  border-top: 1px solid var(--color-borders);
  padding-top: 24px;
}
.support-contact-info p {
  margin-bottom: 10px;
  font-size: 13px;
  opacity: 0.9;
}
.support-contact-info strong {
  margin-right: 8px;
}

@media (max-width: 900px) {
  .faq-layout {
    flex-direction: column;
  }
  .faq-sidebar {
    width: 100%;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const questions = document.querySelectorAll('.faq-question');
  questions.forEach(q => {
    q.addEventListener('click', function() {
      const parent = this.parentElement;
      const isOpen = parent.classList.contains('open');
      
      // Close all others
      document.querySelectorAll('.faq-item').forEach(item => {
        item.classList.remove('open');
      });
      
      // Toggle current
      if (!isOpen) {
        parent.classList.add('open');
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "FAQ Strict",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "SUPPORT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "sidebar_title",
      "label": "Sidebar Title",
      "default": "Still have questions?"
    },
    {
      "type": "textarea",
      "id": "sidebar_text",
      "label": "Sidebar Text",
      "default": "Our team of clinical specialists is available to assist you with tailored advice."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Contact Support"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "care@neoglyn.com"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon-Fri, 9am - 6pm EST"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is the question?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Here is the answer to your question."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Strict",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Is the Neoglyn Lumina safe for all skin types?",
            "answer": "Yes. The Neoglyn Lumina uses non-UV LED light and micro-pulse technology that is FDA-cleared and dermatologist-tested to be safe for all skin tones and types, including sensitive skin."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long until I see results?",
            "answer": "Clinical studies show visible improvements in skin tone and acne reduction within 2 weeks of consistent use (5 minutes daily). Significant reductions in fine lines and deeper wrinkles typically occur after 4 to 8 weeks."
          }
        }
      ]
    }
  ]
}
{% endschema %}
