<div class="page-strict container">
  <header class="page-strict__header">
    <h1 class="page-strict__title">{{ page.title }}</h1>
  </header>
  
  <div class="faq-strict__accordion">
    {% for block in section.blocks %}
      <div class="faq-strict__item">
        <button class="faq-strict__question">{{ block.settings.question }} 
          <span class="faq-strict__icon">+</span>
        </button>
        <div class="faq-strict__answer">
          <p>{{ block.settings.answer }}</p>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="page-strict__content rte" style="margin-top: 60px;">
    {{ page.content }}
  </div>
</div>

<style>
.page-strict {
  padding: 100px 0;
  max-width: 900px;
  margin: 0 auto;
}
.page-strict__header {
  text-align: center;
  margin-bottom: 80px;
}
.page-strict__title {
  font-size: 56px;
  letter-spacing: -1px;
}
.faq-strict__accordion {
  border-top: 2px solid var(--color-borders);
}
.faq-strict__item {
  border-bottom: 2px solid var(--color-borders);
}
.faq-strict__question {
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: 30px 0;
  font-size: 24px;
  font-weight: 700;
  color: var(--color-text);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.faq-strict__icon {
  font-size: 32px;
  font-weight: 400;
}
.faq-strict__answer {
  padding-bottom: 30px;
  font-size: 18px;
  line-height: 1.6;
  color: var(--color-text);
  opacity: 0.9;
  /* Script would typically toggle height/display */
}
@media (max-width: 768px) {
  .page-strict {
    padding: 60px 0;
  }
  .page-strict__title {
    font-size: 40px;
  }
  .faq-strict__question {
    font-size: 20px;
    padding: 24px 0;
  }
}
</style>

{% schema %}
{
  "name": "FAQ strict",
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How rigid is the Neoglyn return policy?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Exact instructions are provided in your clinical packaging."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Section Strict",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
