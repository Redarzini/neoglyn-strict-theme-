<header class="site-header" role="banner">
  <div class="container site-header__inner">
    
    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 220 | image_tag: alt: shop.name }}
        {% else %}
          <span class="logo-text">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="12" y="2" width="10" height="10" transform="rotate(45 12 2)" fill="#7cdcac"/>
              <rect x="12" y="16" width="10" height="10" transform="rotate(45 12 16)" fill="#7cdcac"/>
            </svg>
            Neoglyn
          </span>
        {% endif %}
      </a>
    </div>

    <!-- Desktop Nav -->
    <nav class="site-header__nav" role="navigation">
      <ul class="site-header__menu">
        {% for link in linklists[section.settings.menu].links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% else %}
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.collections_url }}">Products</a></li>
          <li><a href="/pages/about-us">About</a></li>
          <li><a href="/pages/contact">Support</a></li>
        {% endfor %}
      </ul>
    </nav>
    
    <div class="site-header__icons">
      <div class="search-bar hide-mobile">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" placeholder="Search..." aria-label="Search">
      </div>
      
      <a href="/pages/dashboard" class="icon-link hide-mobile" aria-label="Notifications">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
      </a>

      <a href="{{ routes.cart_url }}" class="icon-link" aria-label="Cart">
        <div style="position: relative;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          {% if cart.item_count > 0 %}
            <span class="cart-badge">{{ cart.item_count }}</span>
          {% else %}
            <span class="cart-badge" style="display:none;">0</span>
          {% endif %}
        </div>
      </a>
      
      <a href="{{ routes.account_url }}" class="icon-link hide-mobile" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="mobile-drawer__header">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 120 | image_tag: alt: shop.name, loading: 'lazy' }}
        {% else %}
          <span class="logo-text">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="12" y="2" width="10" height="10" transform="rotate(45 12 2)" fill="#7cdcac"/>
              <rect x="12" y="16" width="10" height="10" transform="rotate(45 12 16)" fill="#7cdcac"/>
            </svg>
            Neoglyn
          </span>
        {% endif %}
      </a>
      <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <ul class="mobile-drawer__menu">
      {% for link in linklists[section.settings.menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% else %}
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="{{ routes.collections_url }}">Products</a></li>
        <li><a href="/pages/about-us">About</a></li>
        <li><a href="/pages/contact">Support</a></li>
      {% endfor %}
      <li><a href="{{ routes.account_url }}">Account</a></li>
    </ul>
  </div>
  <div class="mobile-drawer-overlay" id="mobileDrawerOverlay"></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const closeBtn = document.getElementById('mobileMenuClose');
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.getElementById('mobileDrawerOverlay');

    function openMenu() {
      if(drawer) drawer.classList.add('is-active');
      if(overlay) overlay.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if(drawer) drawer.classList.remove('is-active');
      if(overlay) overlay.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    if(toggleBtn) toggleBtn.addEventListener('click', openMenu);
    if(closeBtn) closeBtn.addEventListener('click', closeMenu);
    if(overlay) overlay.addEventListener('click', closeMenu);
  });
</script>

<style>
.site-header { 
  background-color: var(--color-primary-bg);
  border-bottom: 1px solid var(--color-borders); 
  padding: 16px 0; 
  position: sticky; 
  top: 0; 
  z-index: 1000;
}
.site-header__inner { display: flex; justify-content: space-between; align-items: center; }
.logo-text { font-family: var(--font-heading); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; display: flex; align-items: center; gap: var(--spacing-sm); color: var(--color-heading); }
.site-header__logo a { text-decoration: none; }
.site-header__logo img { max-width: 150px; height: auto; }
.site-header__menu { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--spacing-lg); }
.site-header__menu a { 
  text-decoration: none; 
  color: var(--color-heading); 
  font-family: var(--font-body);
  font-weight: 600; 
  font-size: 0.9rem; 
  transition: var(--transition-smooth); 
}
.site-header__menu a:hover { color: var(--color-primary-btn); }
.site-header__icons { display: flex; align-items: center; gap: var(--spacing-lg); }
.search-bar { display: flex; align-items: center; background: var(--color-secondary-bg); padding: 10px 16px; border-radius: var(--border-radius-pill); gap: 10px; transition: var(--transition-smooth); width: 200px; }
.search-bar:focus-within { background: var(--color-primary-bg); border: 1px solid var(--color-borders); box-shadow: var(--shadow-sm); }
.search-bar input { border: none; background: transparent; outline: none; font-size: 0.875rem; width: 100%; color: var(--color-text); font-family: var(--font-body); }
.icon-link { color: var(--color-heading); transition: var(--transition-smooth); display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background-color: var(--color-secondary-bg); }
.icon-link:hover { background-color: var(--color-borders); color: var(--color-heading); }
.cart-badge { position: absolute; top: -5px; right: -5px; background-color: var(--color-primary-btn); color: var(--color-heading); font-size: 10px; font-weight: 800; border-radius: 10px; padding: 2px 6px; }

/* Mobile Menu Styles */
.mobile-menu-toggle { display: none; background: none; border: none; cursor: pointer; color: var(--color-heading); padding: 0; }
.mobile-drawer { 
  position: fixed; top: 0; left: -100%; width: 85%; max-width: 400px; height: 100vh; 
  background-color: var(--color-primary-bg); z-index: 1001; 
  transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1); 
  display: flex; flex-direction: column; box-shadow: var(--shadow-lg); 
}
.mobile-drawer.is-active { left: 0; }
.mobile-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: var(--spacing-lg); border-bottom: 1px solid var(--color-borders); }
.mobile-menu-close { background: none; border: none; cursor: pointer; color: var(--color-heading); padding: 0; }
.mobile-drawer__menu { list-style: none; padding: var(--spacing-lg); margin: 0; display: flex; flex-direction: column; gap: var(--spacing-lg); overflow-y: auto; }
.mobile-drawer__menu a { text-decoration: none; color: var(--color-heading); font-family: var(--font-heading); font-weight: 700; font-size: 1.25rem; transition: var(--transition-smooth); }
.mobile-drawer__menu a:hover { color: var(--color-primary-btn); }
.mobile-drawer-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(8, 26, 46, 0.4); backdrop-filter: blur(4px); z-index: 1000; opacity: 0; visibility: hidden; transition: all 0.4s ease; }
.mobile-drawer-overlay.is-active { opacity: 1; visibility: visible; }

@media (max-width: 900px) { 
  .site-header__menu, .hide-mobile { display: none; } 
  .mobile-menu-toggle { display: block; }
  .site-header__logo { flex: 1; display: flex; justify-content: center; } 
  .site-header__icons { flex: 0; gap: var(--spacing-sm); }
  .icon-link { background-color: transparent; width: auto; height: auto; }
}
</style>

{% schema %}
{
  "name": "Header Strict",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
