<header class="site-header" role="banner">
  <div class="container site-header__inner">
    
    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name }}
        {% else %}
          <span class="logo-text">{{ shop.name | upcase }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Desktop Nav -->
    <nav class="site-header__nav" role="navigation">
      <ul class="site-header__menu">
        {% for link in linklists[section.settings.menu].links %}
          <li><a href="{{ link.url }}">{{ link.title | upcase }}</a></li>
        {% else %}
          <li><a href="{{ routes.all_products_collection_url }}">DEVICES</a></li>
          <li><a href="/collections/serums">SERUMS</a></li>
          <li><a href="/pages/science">SCIENCE</a></li>
          <li><a href="/pages/results">RESULTS</a></li>
        {% endfor %}
      </ul>
    </nav>
    
    <div class="site-header__icons">
      <div class="search-bar hide-mobile">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" placeholder="Search">
      </div>
      <a href="{{ routes.cart_url }}" class="icon-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </a>
      <a href="{{ routes.account_url }}" class="icon-link hide-mobile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="mobile-drawer__header">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 120 | image_tag: alt: shop.name, loading: 'lazy' }}
        {% else %}
          <span class="logo-text">{{ shop.name | upcase }}</span>
        {% endif %}
      </a>
      <button class="mobile-menu-close" id="mobileMenuClose">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <ul class="mobile-drawer__menu">
      {% for link in linklists[section.settings.menu].links %}
        <li><a href="{{ link.url }}">{{ link.title | upcase }}</a></li>
      {% else %}
        <li><a href="{{ routes.all_products_collection_url }}">DEVICES</a></li>
        <li><a href="/collections/serums">SERUMS</a></li>
        <li><a href="/pages/science">SCIENCE</a></li>
        <li><a href="/pages/results">RESULTS</a></li>
      {% endfor %}
      <li><a href="{{ routes.account_url }}">ACCOUNT</a></li>
    </ul>
  </div>
  <div class="mobile-drawer-overlay" id="mobileDrawerOverlay"></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const closeBtn = document.getElementById('mobileMenuClose');
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.getElementById('mobileDrawerOverlay');

    function openMenu() {
      drawer.classList.add('is-active');
      overlay.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      drawer.classList.remove('is-active');
      overlay.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    if(toggleBtn) toggleBtn.addEventListener('click', openMenu);
    if(closeBtn) closeBtn.addEventListener('click', closeMenu);
    if(overlay) overlay.addEventListener('click', closeMenu);
  });
</script>

<style>
.site-header { background-color: var(--color-primary-bg); border-bottom: 1px solid var(--color-borders); padding: 16px 0; position: sticky; top: 0; z-index: 100; }
.site-header__inner { display: flex; justify-content: space-between; align-items: center; }
.logo-text { font-weight: 800; font-size: 20px; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; }
.logo-text::before { content: "✦"; color: var(--color-primary-btn); font-size: 24px; }
.site-header__logo a { text-decoration: none; color: var(--color-text); }
.site-header__logo img { max-width: 150px; height: auto; }
.site-header__menu { list-style: none; margin: 0; padding: 0; display: flex; gap: 32px; }
.site-header__menu a { text-decoration: none; color: var(--color-text); font-weight: 600; font-size: 11px; letter-spacing: 1.5px; transition: color 0.2s; }
.site-header__menu a:hover { color: var(--color-primary-btn); }
.site-header__icons { display: flex; align-items: center; gap: 20px; }
.search-bar { display: flex; align-items: center; background: var(--color-secondary-bg); padding: 8px 16px; border-radius: 20px; gap: 10px; }
.search-bar input { border: none; background: transparent; outline: none; font-size: 12px; width: 120px; }
.icon-link { color: var(--color-text); transition: color 0.2s; }
.icon-link:hover { color: var(--color-primary-btn); }

/* Mobile Menu Styles */
.mobile-menu-toggle { display: none; background: none; border: none; cursor: pointer; color: var(--color-text); padding: 0; }
.mobile-drawer { position: fixed; top: 0; left: -100%; width: 80%; max-width: 400px; height: 100vh; background-color: var(--color-primary-bg); z-index: 1000; transition: left 0.3s ease; display: flex; flex-direction: column; box-shadow: 2px 0 10px rgba(0,0,0,0.1); }
.mobile-drawer.is-active { left: 0; }
.mobile-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px solid var(--color-borders); }
.mobile-menu-close { background: none; border: none; cursor: pointer; color: var(--color-text); padding: 0; }
.mobile-drawer__menu { list-style: none; padding: 20px; margin: 0; display: flex; flex-direction: column; gap: 24px; }
.mobile-drawer__menu a { text-decoration: none; color: var(--color-text); font-weight: 700; font-size: 16px; letter-spacing: 1px; }
.mobile-drawer-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 999; opacity: 0; visibility: hidden; transition: all 0.3s ease; }
.mobile-drawer-overlay.is-active { opacity: 1; visibility: visible; }

@media (max-width: 900px) { 
  .site-header__menu, .hide-mobile { display: none; } 
  .mobile-menu-toggle { display: block; }
  .site-header__logo { flex: 1; display: flex; justify-content: center; } /* Center logo on mobile */
  .site-header__icons { flex: 0; }
}
</style>

{% schema %}
{
  "name": "Header Strict",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
