<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}">
        <span class="logo-text">NEOGLYN</span>
      </a>
    </div>

    <nav class="site-header__nav" role="navigation">
      <ul class="site-header__menu">
        <li><a href="/collections/all">DEVICES</a></li>
        <li><a href="/collections/serums">SERUMS</a></li>
        <li><a href="/pages/science">SCIENCE</a></li>
        <li><a href="/pages/results">RESULTS</a></li>
      </ul>
    </nav>
    
    <div class="site-header__icons">
      <div class="search-bar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" placeholder="Search collection">
      </div>
      <a href="{{ routes.cart_url }}" class="icon-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </a>
      <a href="{{ routes.account_url }}" class="icon-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>
    </div>
  </div>
</header>

<style>
.site-header {
  background-color: var(--color-primary-bg);
  border-bottom: 1px solid var(--color-borders);
  padding: 16px 0;
  position: sticky;
  top: 0;
  z-index: 100;
}
.site-header__inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.logo-text {
  font-weight: 800;
  font-size: 20px;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.logo-text::before {
  content: "✦";
  color: var(--color-primary-btn);
  font-size: 24px;
}
.site-header__logo a {
  text-decoration: none;
  color: var(--color-text);
}
.site-header__menu {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  gap: 32px;
}
.site-header__menu a {
  text-decoration: none;
  color: var(--color-text);
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 1.5px;
}
.site-header__icons {
  display: flex;
  align-items: center;
  gap: 20px;
}
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-secondary-bg);
  padding: 8px 16px;
  border-radius: 20px;
  gap: 10px;
}
.search-bar input {
  border: none;
  background: transparent;
  outline: none;
  font-size: 12px;
  width: 150px;
}
.icon-link {
  color: var(--color-text);
}
@media (max-width: 900px) {
  .site-header__menu, .search-bar {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Header Strict",
  "settings": []
}
{% endschema %}
