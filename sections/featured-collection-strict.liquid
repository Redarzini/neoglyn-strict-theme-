<div class="featured-strict container">
  <div class="featured-strict__header">
    <div class="featured-title">
      <div class="caption">{{ section.settings.caption | default: 'MEMBER FAVORITES' }}</div>
      <h2>{{ section.settings.title | default: 'The Routine' }}</h2>
    </div>
    <a href="{{ section.settings.linked_collection.url | default: routes.all_products_collection_url }}" class="btn btn--outline hide-mobile">{{ section.settings.btn_text | default: 'SHOP ALL' }}</a>
  </div>
  
  <div class="product-grid">
    {% assign collection = section.settings.linked_collection %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: section.settings.product_limit %}
        <div class="product-card">
          <div class="product-card__image">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 400 | image_tag: alt: product.title, loading: 'lazy' }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
            <div class="product-badges">
              {% if product.compare_at_price > product.price %}
                <span class="badge badge--sale">SALE</span>
              {% endif %}
            </div>
            
            <form method="post" action="/cart/add" class="quick-add-form">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="btn quick-add-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </button>
            </form>
          </div>
          
          <div class="product-card__info">
            <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="product-card__price">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}
                <s class="compare-price">{{ product.compare_at_price | money }}</s>
              {% endif %}
            </p>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Fallback empty state -->
      {% for i in (1..section.settings.product_limit) %}
        <div class="product-card">
          <div class="product-card__image">
            <img src="https://images.unsplash.com/photo-1615397323608-8e805d7b5b5c?q=80&w=400&auto=format&fit=crop" alt="Placeholder Product" width="400" height="400" loading="lazy">
            <div class="product-badges">
              <span class="badge badge--award">AWARD WINNER</span>
            </div>
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title"><a href="#">Neoglyn Example {{ i }}</a></h3>
            <p class="product-card__price">$149.00</p>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  
  <a href="{{ section.settings.linked_collection.url | default: routes.all_products_collection_url }}" class="btn btn--outline show-mobile text-center" style="width: 100%; margin-top: 30px;">{{ section.settings.btn_text | default: 'SHOP ALL' }}</a>
</div>

<style>
.featured-strict { padding: 80px 0; }
.featured-strict__header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
.featured-title h2 { font-size: 36px; margin: 8px 0 0; }
.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
.product-card { position: relative; }
.product-card__image { position: relative; aspect-ratio: 3/4; background-color: var(--color-secondary-bg); border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
.product-card__image img, .product-card__image svg { width: 100%; height: 100%; object-fit: cover; }
.product-badges { position: absolute; top: 16px; left: 16px; display: flex; flex-direction: column; gap: 8px; }
.badge { font-size: 10px; font-weight: 800; letter-spacing: 1px; padding: 6px 12px; border-radius: 20px; text-transform: uppercase; }
.badge--award { background-color: var(--color-text); color: var(--color-primary-bg); }
.badge--sale { background-color: var(--color-primary-btn); color: var(--color-text); }
.quick-add-form { position: absolute; bottom: 16px; right: 16px; margin: 0; }
.quick-add-btn { width: 44px; height: 44px; padding: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: var(--color-text); color: var(--color-primary-bg); transition: transform 0.2s; }
.quick-add-btn:hover { transform: scale(1.05); }
.product-card__info { padding: 0 4px; }
.product-card__title { font-size: 16px; margin-bottom: 8px; }
.product-card__title a { text-decoration: none; color: var(--color-text); }
.product-card__price { font-size: 14px; font-weight: 600; display: flex; gap: 8px; }
.compare-price { color: var(--color-text); opacity: 0.5; font-weight: 400; }
.show-mobile { display: none; }
@media (max-width: 900px) { .hide-mobile { display: none; } .show-mobile { display: block; } .product-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } .quick-add-btn { width: 36px; height: 36px; } }
@media (max-width: 600px) { .product-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Featured Collection Strict",
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "MEMBER FAVORITES" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Routine" },
    { "type": "collection", "id": "linked_collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "SHOP ALL" }
  ],
  "presets": [
    { "name": "Featured Collection Strict" }
  ]
}
{% endschema %}
