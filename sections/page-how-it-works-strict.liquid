<div class="science-radiance-section section-padding">
  <div class="container text-center fade-in-up">
    <h1 class="science-title">{{ section.settings.title | default: 'The Science of Radiance' }}</h1>
    <p class="science-subtitle">{{ section.settings.subtitle | default: 'Experience the synergy of clinical-grade LED light therapy combined with our proprietary serums for unmatched results.' }}</p>
  </div>

  <div class="container science-features">
    {% for block in section.blocks %}
      <div class="science-feature fade-in-up {% cycle 'row', 'row-reverse' %}" {{ block.shopify_attributes }} style="animation-delay: {{ forloop.index | times: 100 }}ms;">
        
        <div class="science-feature__content">
          <div class="feature-number">0{{ forloop.index }}.</div>
          <h2 class="feature-heading">{{ block.settings.title }}</h2>
          <div class="feature-text">{{ block.settings.text }}</div>
          {% if block.settings.button_link != blank %}
            <a href="{{ block.settings.button_link }}" class="feature-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
        
        <div class="science-feature__image">
          {% if block.settings.image != blank %}
            <div class="image-wrapper">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'radiance-img' }}
            </div>
          {% else %}
            <div class="image-wrapper placeholder-wrapper" style="padding: 0;">
              <img src="{{ 'demo-skin-after.jpg' | asset_url }}" alt="Targeted LED Therapy" class="radiance-img" loading="lazy" width="800" height="1000">
            </div>
          {% endif %}
        </div>

      </div>
    {% else %}
      <!-- Placeholder content matching screenshot -->
      <div class="science-feature fade-in-up">
        <div class="science-feature__content">
          <div class="feature-number">01.</div>
          <h2 class="feature-heading">Targeted LED Therapy</h2>
          <div class="feature-text">
            <p>Our tri-wave technology utilizes deep penetrating light at optimal bandwidths to target cells beneath the skin's surface. Blue light eliminates acne-causing bacteria, while red and near-infrared light stimulate collagen production and reduce inflammation.</p>
          </div>
          <a href="#" class="feature-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Explore Clinical Studies
          </a>
        </div>
        <div class="science-feature__image">
          <div class="image-wrapper" style="padding: 0;">
            <img src="{{ 'demo-skin-after.jpg' | asset_url }}" alt="Placeholder" class="radiance-img" loading="lazy" width="800" height="1000">
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
.science-radiance-section {
  background-color: var(--color-primary-bg);
  overflow: hidden;
}

.science-title {
  font-size: 3rem;
  margin-bottom: var(--spacing-sm);
  color: var(--color-heading);
  letter-spacing: -0.02em;
}

.science-subtitle {
  font-size: 1.125rem;
  color: var(--color-text-muted);
  max-width: 600px;
  margin: 0 auto var(--spacing-3xl);
  line-height: 1.6;
}

.science-features {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3xl);
}

.science-feature {
  display: flex;
  align-items: center;
  gap: 80px;
}

.science-feature.row-reverse {
  flex-direction: row-reverse;
}

.science-feature__content {
  flex: 1;
  max-width: 480px;
  padding-left: 20px; /* Slight offset for layout aesthetics */
}

.feature-number {
  font-family: var(--font-heading);
  font-size: 3.5rem;
  font-weight: 800;
  color: var(--color-borders);
  line-height: 1;
  margin-bottom: var(--spacing-sm);
  letter-spacing: -0.05em;
}

.feature-heading {
  font-size: 2rem;
  margin-bottom: var(--spacing-md);
  color: var(--color-heading);
}

.feature-text {
  font-size: 1rem;
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: var(--spacing-xl);
}

.feature-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.875rem;
  color: var(--color-heading);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-decoration: none;
  border-bottom: 2px solid transparent;
  padding-bottom: 4px;
  transition: var(--transition-smooth);
}

.feature-link svg {
  color: var(--color-primary-btn);
}

.feature-link:hover {
  color: var(--color-primary-btn);
  border-bottom-color: var(--color-primary-btn);
}

.science-feature__image {
  flex: 1;
}

.image-wrapper {
  position: relative;
  background-color: var(--color-secondary-bg);
  border-radius: var(--border-radius-xl);
  padding: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.radiance-img {
  width: 100%;
  height: auto;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-lg);
  object-fit: cover;
  aspect-ratio: 4/5;
}

.placeholder-wrapper {
  aspect-ratio: 4/5;
}

.placeholder-svg {
  width: 100%;
  height: 100%;
  fill: #ccc;
}

@media (max-width: 900px) {
  .science-title {
    font-size: 2.25rem;
  }
  .science-feature, 
  .science-feature.row-reverse {
    flex-direction: column;
    gap: 40px;
  }
  .science-feature__content {
    max-width: 100%;
    padding-left: 0;
  }
  .image-wrapper {
    padding: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Science of Radiance",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Science of Radiance"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Text",
      "default": "Experience the synergy of clinical-grade LED light therapy combined with our proprietary serums for unmatched results."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Targeted LED Therapy"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Our tri-wave technology utilizes deep penetrating light at optimal bandwidths to target cells beneath the skin's surface.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "Explore Clinical Studies"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science of Radiance",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
