<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__links">
      {% for index in (1..3) %}
        {% assign menu_setting = 'footer_linklist_' | append: index %}
        {% assign menu = section.settings[menu_setting] %}
        {% if menu != blank %}
          <div class="site-footer__column">
            <h3>{{ linklists[menu].title }}</h3>
            <ul>
              {% for link in linklists[menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
      
      <div class="site-footer__column site-footer__newsletter">
        <h3>Newsletter</h3>
        <p>Subscribe for updates on new Neoglyn releases.</p>
        <form action="#" class="newsletter-form">
          <input type="email" placeholder="Email Address" required>
          <button type="submit" class="btn">Subscribe</button>
        </form>
      </div>
    </div>
    
    <div class="site-footer__bottom">
      <div class="site-footer__copyright">
        &copy; {{ 'now' | date: "%Y" }}, {{ shop.name }}. All rights reserved. Strictly Beauty Tools.
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background-color: var(--color-primary-bg);
  border-top: 2px solid var(--color-borders);
  padding: 80px 0 40px;
  margin-top: 80px;
}
.site-footer__links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 40px;
  margin-bottom: 60px;
}
.site-footer__column h3 {
  font-size: 16px;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 24px;
  color: var(--color-text);
}
.site-footer__column ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
.site-footer__column li {
  margin-bottom: 12px;
}
.site-footer__column a {
  text-decoration: none;
  color: var(--color-text);
  font-size: 15px;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}
.site-footer__column a:hover {
  opacity: 1;
}
.newsletter-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 20px;
}
.newsletter-form input {
  padding: 12px 16px;
  border: 1px solid var(--color-borders);
  border-radius: 4px;
  font-size: 14px;
  color: var(--color-text);
  background: var(--color-primary-bg);
}
.newsletter-form .btn {
  padding: 12px 16px;
  width: 100%;
}
.site-footer__bottom {
  border-top: 1px solid var(--color-borders);
  padding-top: 40px;
  display: flex;
  justify-content: center;
}
.site-footer__copyright {
  font-size: 14px;
  color: var(--color-text);
  font-weight: 500;
}
@media (max-width: 768px) {
  .site-footer__links {
    grid-template-columns: 1fr;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Footer Strict",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_linklist_1",
      "label": "Primary Footer Menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "footer_linklist_2",
      "label": "Secondary"
    },
    {
      "type": "link_list",
      "id": "footer_linklist_3",
      "label": "Tertiary"
    }
  ]
}
{% endschema %}
