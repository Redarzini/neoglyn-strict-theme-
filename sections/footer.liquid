<footer class="site-footer-strict">
  <div class="container site-footer-strict__inner">
    
    <div class="footer-brand">
      <div class="logo-text">NEOGLYN</div>
      <p>Redefining beauty through technology. Our clinical-grade devices are engineered to deliver professional results without the office visit.</p>
      <div class="footer-social">
        <a href="#"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
        <a href="#"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
      </div>
    </div>
    
    <div class="footer-links">
      <div class="footer-column">
        <h3>SHOP</h3>
        <ul>
          <li><a href="#">Lumina Collection</a></li>
          <li><a href="#">Treatment Serums</a></li>
          <li><a href="#">Bundles</a></li>
          <li><a href="#">Gift Cards</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>LEARN</h3>
        <ul>
          <li><a href="#">How it Works</a></li>
          <li><a href="#">Clinical Studies</a></li>
          <li><a href="#">Help Center</a></li>
          <li><a href="#">Contact Us</a></li>
        </ul>
      </div>
    </div>
    
  </div>
  
  <div class="container">
    <div class="site-footer-strict__bottom">
      <div class="copyright">
        &copy; {{ 'now' | date: "%Y" }} NEOGLYN TECH. ALL RIGHTS RESERVED.
      </div>
      <div class="legal-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS OF SERVICE</a>
      </div>
    </div>
  </div>
</footer>

<style>
/* Continuing seamlessly from the dark clinical section */
.site-footer-strict {
  background-color: var(--color-dark-bg);
  color: var(--color-dark-text);
  padding: 80px 0 40px;
}
.site-footer-strict__inner {
  display: flex;
  justify-content: space-between;
  margin-bottom: 80px;
  gap: 40px;
}
.footer-brand {
  max-width: 300px;
}
.footer-brand .logo-text {
  color: var(--color-dark-text);
  margin-bottom: 20px;
}
.footer-brand p {
  font-size: 12px;
  line-height: 1.8;
  opacity: 0.7;
  margin-bottom: 30px;
}
.footer-social {
  display: flex;
  gap: 16px;
}
.footer-social a {
  color: var(--color-dark-text);
  opacity: 0.8;
  transition: opacity 0.2s ease;
}
.footer-social a:hover {
  opacity: 1;
}

.footer-links {
  display: flex;
  gap: 100px;
}
.footer-column h3 {
  color: var(--color-primary-btn);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 24px;
}
.footer-column ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
.footer-column li {
  margin-bottom: 16px;
}
.footer-column a {
  text-decoration: none;
  color: var(--color-dark-text);
  font-size: 13px;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}
.footer-column a:hover {
  opacity: 1;
  color: var(--color-primary-btn);
}

.site-footer-strict__bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 10px;
  letter-spacing: 1px;
  opacity: 0.6;
}
.legal-links {
  display: flex;
  gap: 20px;
}
.legal-links a {
  color: var(--color-dark-text);
  text-decoration: none;
}

@media (max-width: 768px) {
  .site-footer-strict__inner {
    flex-direction: column;
  }
  .footer-links {
    gap: 50px;
    flex-direction: column;
  }
  .site-footer-strict__bottom {
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Footer Strict (Dark)",
  "settings": []
}
{% endschema %}
