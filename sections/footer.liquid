<footer class="site-footer-strict">
  <div class="container site-footer-strict__inner">
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      
      <div class="footer-brand">
        <h2 class="footer-logo">{{ shop.name | upcase }}</h2>
        <p>{{ section.settings.brand_text | default: 'Science-backed skincare technology engineered for uncompromised results.' }}</p>
      </div>
      
      {% for block in section.blocks %}
        {% if block.type == 'link_list' %}
          <div class="footer-links" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title | default: linklists[block.settings.menu].title }}</h3>
            <ul>
              {% for link in linklists[block.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% else %}
                <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
                <li><a href="/pages/how-it-works">How It Works</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
      
    </div>
    
    <div class="footer-bottom">
      <div class="footer-legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      </div>
      <div class="footer-payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer { background-color: var(--color-footer-bg, #001F3F); color: white; padding: 100px 0 40px; }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 60px; margin-bottom: 80px; }
.footer-logo { font-size: 24px; font-weight: 800; letter-spacing: 2px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px; }
.footer-logo::before { content: "✦"; color: var(--color-primary-btn); }
.footer-brand p { opacity: 0.7; font-size: 14px; line-height: 1.6; max-width: 300px; }
.footer-links h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 24px; opacity: 0.5; }
.footer-links ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
.footer-links a { color: white; text-decoration: none; font-size: 14px; opacity: 0.9; transition: opacity 0.2s; }
.footer-links a:hover { opacity: 1; color: var(--color-primary-btn); }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 30px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; opacity: 0.6; }
.payment-icon { width: 38px; height: 24px; margin-left: 8px; }
@media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; } .footer-brand { grid-column: span 2; } }
@media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; } .footer-brand { grid-column: span 1; } .footer-bottom { flex-direction: column; gap: 20px; text-align: center; } }
</style>

{% schema %}
{
  "name": "Footer Strict",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand Description"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "title": "Shop", "menu": "main-menu" } },
      { "type": "link_list", "settings": { "title": "Support", "menu": "footer" } }
    ]
  }
}
{% endschema %}
