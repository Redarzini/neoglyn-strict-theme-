<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      
      <div class="footer-brand">
        <h2 class="footer-logo">
          <!-- Stylized logo placeholder based on screenshots -->
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="12" y="2" width="10" height="10" transform="rotate(45 12 2)" fill="#7cdcac"/>
            <rect x="12" y="16" width="10" height="10" transform="rotate(45 12 16)" fill="#7cdcac"/>
          </svg>
          {{ shop.name }}
        </h2>
        <p>{{ section.settings.brand_text | default: 'Redefining beauty through technology. Our clinical-grade devices are engineered to deliver professional results without the office visit.' }}</p>
        <div class="footer-socials">
          <a href="#" aria-label="Share"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg></a>
          <a href="#" aria-label="Globe"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg></a>
        </div>
      </div>
      
      {% for block in section.blocks %}
        {% if block.type == 'link_list' %}
          <div class="footer-links" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title | default: linklists[block.settings.menu].title }}</h3>
            <ul>
              {% for link in linklists[block.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% else %}
                {% if forloop.index == 1 %}
                  <li><a href="{{ routes.collections_url }}">Lumina Collection</a></li>
                  <li><a href="{{ routes.collections_url }}">Treatment Serums</a></li>
                  <li><a href="#">Bundles</a></li>
                  <li><a href="#">Gift Cards</a></li>
                {% else %}
                  <li><a href="/pages/how-it-works">How It Works</a></li>
                  <li><a href="#">Clinical Studies</a></li>
                  <li><a href="/pages/faq">Help Center</a></li>
                  <li><a href="/pages/contact">Contact Us</a></li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}

      {% if section.blocks.size < 3 %}
        <div class="footer-links">
          <h3>SOCIAL</h3>
          <ul>
            <li><a href="#">Instagram</a></li>
            <li><a href="#">Twitter</a></li>
            <li><a href="#">LinkedIn</a></li>
          </ul>
        </div>
      {% endif %}
      
    </div>
    
    <div class="footer-bottom">
      <div class="footer-legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} TECHNOLOGIES. ALL RIGHTS RESERVED.</p>
      </div>
      <div class="footer-policy-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS OF SERVICE</a>
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer { background-color: var(--color-dark-bg); color: var(--color-dark-text); padding: 80px 0 30px; }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 60px; }
.footer-logo { font-size: 1.25rem; font-weight: 800; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--color-dark-text); }
.footer-brand p { color: var(--color-dark-text-muted); font-size: 0.875rem; line-height: 1.6; max-width: 320px; font-family: var(--font-body); margin-bottom: 24px; }
.footer-socials { display: flex; gap: 16px; align-items: center; }
.footer-socials a { color: var(--color-dark-text-muted); opacity: 0.8; transition: var(--transition-smooth); }
.footer-socials a:hover { color: var(--color-primary-btn); opacity: 1; }
.footer-links h3 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 20px; color: var(--color-dark-text); opacity: 0.9; }
.footer-links ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
.footer-links a { color: var(--color-dark-text-muted); text-decoration: none; font-size: 0.875rem; transition: var(--transition-smooth); font-family: var(--font-body); }
.footer-links a:hover { color: var(--color-primary-btn); }
.footer-bottom { border-top: 1px solid rgba(255,255,255,0.05); padding-top: 30px; display: flex; justify-content: space-between; align-items: center; font-size: 0.7rem; color: var(--color-dark-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
.footer-legal p { margin: 0; font-size: inherit; color: inherit; }
.footer-policy-links { display: flex; gap: 24px; }
.footer-policy-links a { color: inherit; transition: var(--transition-smooth); }
.footer-policy-links a:hover { color: var(--color-primary-btn); }
@media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; } .footer-brand { grid-column: span 2; } }
@media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; } .footer-brand { grid-column: span 1; } .footer-bottom { flex-direction: column; gap: 20px; text-align: center; } }
</style>

{% schema %}
{
  "name": "Footer Strict",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand Description"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "title": "Shop", "menu": "main-menu" } },
      { "type": "link_list", "settings": { "title": "Explore", "menu": "footer" } }
    ]
  }
}
{% endschema %}
