<div class="cart-strict container">
  <div class="cart-strict__header">
    <h1>Your Cart</h1>
    <a href="{{ routes.all_products_collection_url }}" class="cart-strict__continue">Continue Shopping</a>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-strict__form">
      <div class="cart-strict__items">
        {% for item in cart.items %}
          <div class="cart-item-strict">
            <div class="cart-item-strict__image">
              <img src="{{ item.image | img_url: '300x' }}" alt="{{ item.title | escape }}">
            </div>
            <div class="cart-item-strict__details">
              <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
              <p class="cart-item-strict__price">{{ item.final_line_price | money }}</p>
              
              <div class="cart-item-strict__quantity">
                <label for="updates_{{ item.key }}">Quantity</label>
                <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0">
              </div>
              
              <a href="{{ item.url_to_remove }}" class="cart-item-strict__remove">Remove</a>
            </div>
          </div>
        {% endfor %}
      </div>
      
      <div class="cart-strict__footer">
        <div class="cart-strict__subtotal">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-strict__taxes">Taxes and shipping calculated at checkout.</p>
        
        <div class="cart-strict__buttons">
          <button type="submit" name="update" class="btn btn--outline">Update Cart</button>
          <button type="submit" name="checkout" class="btn">Checkout</button>
        </div>
      </div>
    </form>
  {% else %}
    <div class="cart-strict__empty">
      <p>Your cart is currently empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">Shop Devices</a>
    </div>
  {% endif %}
</div>

<style>
.cart-strict {
  padding: 80px 0;
  max-width: 1000px;
}
.cart-strict__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 40px;
  border-bottom: 2px solid var(--color-borders);
  padding-bottom: 20px;
}
.cart-strict__header h1 {
  font-size: 40px;
  margin: 0;
}
.cart-strict__continue {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text);
  text-decoration: underline;
}
.cart-item-strict {
  display: flex;
  gap: 30px;
  padding: 30px 0;
  border-bottom: 1px solid rgba(0,31,63,0.1);
}
.cart-item-strict__image img {
  width: 150px;
  border-radius: 4px;
  border: 1px solid var(--color-borders);
}
.cart-item-strict__details {
  flex: 1;
}
.cart-item-strict__details h3 {
  font-size: 20px;
  margin-bottom: 8px;
}
.cart-item-strict__details h3 a {
  text-decoration: none;
  color: var(--color-text);
}
.cart-item-strict__price {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 16px;
}
.cart-item-strict__quantity {
  margin-bottom: 16px;
}
.cart-item-strict__quantity label {
  display: block;
  font-size: 12px;
  text-transform: uppercase;
  font-weight: 700;
  margin-bottom: 4px;
}
.cart-item-strict__quantity input {
  padding: 8px;
  width: 80px;
  border: 1px solid var(--color-borders);
  text-align: center;
}
.cart-item-strict__remove {
  font-size: 14px;
  color: #ff4d4f;
  text-decoration: underline;
  font-weight: 600;
}
.cart-strict__footer {
  margin-top: 40px;
  text-align: right;
}
.cart-strict__subtotal {
  font-size: 24px;
  font-weight: 700;
  display: flex;
  justify-content: flex-end;
  gap: 20px;
  margin-bottom: 12px;
}
.cart-strict__taxes {
  font-size: 14px;
  opacity: 0.8;
  margin-bottom: 24px;
}
.cart-strict__buttons {
  display: flex;
  justify-content: flex-end;
  gap: 16px;
}
.cart-strict__empty {
  text-align: center;
  padding: 60px 0;
  border: 1px dashed var(--color-borders);
  border-radius: 4px;
  background-color: #FAFAFA;
}
.cart-strict__empty p {
  font-size: 20px;
  margin-bottom: 24px;
}
</style>

{% schema %}
{
  "name": "Cart strict",
  "settings": []
}
{% endschema %}
